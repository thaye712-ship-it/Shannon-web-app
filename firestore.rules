rules_version = '2';

/*
  Provenance — Firestore security rules
  ------------------------------------------------------------------
  Only needed if you switch js/firebase-config.js to mode 'firebase'.
  Until then the app runs entirely on the device and none of this
  applies.

  Paste into Firebase console → Firestore Database → Rules → Publish
  BEFORE flipping that switch.

  WHAT THIS PROTECTS, HONESTLY
  The app has no accounts. Anyone picks a name and trains. That means
  these rules cannot tell one person from another, so anyone with the
  link can read the roster, add a name, and write progress. That is
  the intended trust model for a shared showroom device, and it is
  fine for practice scores.

  It is NOT fine if these numbers ever inform a performance
  conversation. At that point people need real accounts — see the
  block at the bottom for what changes.

  The rules still do real work: they stop the database being used as
  free storage for anything other than this app's shape, and they
  keep the collections scoped to one org.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    match /orgs/{orgId} {

      // ---- Profiles: name, avatar ----
      match /profiles/{profileId} {
        allow read: if true;

        // Shape check: keeps the collection to profiles and nothing else.
        allow create, update: if request.resource.data.keys().hasOnly(
                                   ['name', 'emoji', 'createdAt'])
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 40;

        allow delete: if true;
      }

      // ---- Progress: XP, streak, badges, mastery, flashcard marks ----
      match /progress/{profileId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Anything not matched above is denied.
  }
}

/*
  ------------------------------------------------------------------
  WHEN YOU WANT MANAGERS AND TRUSTWORTHY NUMBERS

  Two changes, both in the console:

  1. Give people real accounts (Authentication → Email/Password), then
     tie progress to the signed-in user so nobody can write anyone
     else's:

       match /progress/{profileId} {
         allow read: if request.auth != null;
         allow write: if request.auth != null
                      && request.auth.uid == profileId;
       }

  2. Add managers as documents in a `managers` collection, writable
     only by existing managers, with the first created by hand in the
     console so there is no way to promote yourself from the app:

       function isManager() {
         return request.auth != null
           && exists(/databases/$(database)/documents/orgs/$(orgId)/managers/$(request.auth.uid));
       }

       match /managers/{uid} {
         allow read: if request.auth != null;
         allow write: if isManager();
       }

     Then restrict profile edits with `allow update, delete: if isManager();`

  The app would need matching UI for both. Ask and I'll build it.
*/
